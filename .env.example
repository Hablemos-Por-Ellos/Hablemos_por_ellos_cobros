NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Solo para revisar la maqueta local sin una sesion real. Nunca habilitar en produccion.
ADMIN_DEMO_MODE="true"

