###############################################
# App
###############################################
NEXT_PUBLIC_WOMPI_ENV="sandbox"
APP_OPERATION_MODE="demo"
NEXT_PUBLIC_APP_OPERATION_MODE="demo"
FINANCIAL_OPERATIONS_ENABLED="false"
MAINTENANCE_MODE="false"
CRON_SECRET="CHANGE_ME_RANDOM"
CHECKOUT_TOKEN_PEPPER="CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS"

###############################################
# Supabase
###############################################
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
